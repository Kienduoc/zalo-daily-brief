# ================= CAU HINH THU KY AI ZALO =================
# File nay duoc bo cai chep thanh .env — sua gia tri o day roi khoi dong lai phan mem.

# ===== BO NAO AI =====
# claude-code = dang nhap truc tiep tai khoan Claude (subscription). Khong can API key.
#               Yeu cau: npm install -g @anthropic-ai/claude-code  roi go: claude  (dang nhap 1 lan)
# openai      = endpoint HTTP tuong thich OpenAI (dien 3 dong LLM_* ben duoi)
LLM_PROVIDER=claude-code
# (Tuy chon) ep model cho claude-code, vd haiku de tiet kiem: CLAUDE_MODEL=haiku
#CLAUDE_MODEL=

# ===== Phuong an phu: endpoint HTTP (chi dung khi LLM_PROVIDER=openai) =====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== Email nhan brief (bo trong = khong gui email, van xem tren giao dien) =====
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Thu ky AI Zalo <no-reply@example.com>
MAIL_TO=
MAIL_SUBJECT_PREFIX=[Bao cao Hang ngay]

# ===== Lich tu dong tom tat (mac dinh 18:00 Thu 2 - Thu 6, gio VN) =====
SUMMARY_CRON=0 18 * * 1-5
TZ=Asia/Ho_Chi_Minh

# ===== Pham vi theo doi =====
WATCH_ALL_GROUPS=true

# ===== Quet tai khoan dinh ky (phut/lan) =====
SCAN_MINUTES=5

# ===== Khoa phan mem (bo trong = khong khoa; dat ma thi nguoi dung phai nhap Key) =====
APP_KEY=
